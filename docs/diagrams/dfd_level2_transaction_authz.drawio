        <mxCell id="e5" value="WHERE id = :id AND user_id = :U_101" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#2e7d32;" edge="1" source="p3_1" target="d_txn" />
        <mxCell id="e6" value="Query Result (Row or None)" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" source="d_txn" target="p3_2" />
        <mxCell id="e7" value="HTTP 200 / 201 (or 404 Not Found)" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" source="p3_2" target="actor_user" />
