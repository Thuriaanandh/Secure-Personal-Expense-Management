        <mxCell id="b4_1" value="&lt;b&gt;[PATH 4.1: Unscoped Export]&lt;/b&gt;&lt;br&gt;1. Request /reports/export-csv&lt;br&gt;2. Tamper with account query param&lt;br&gt;&lt;i&gt;[AND-Branch]&lt;/i&gt;" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=0;fontSize=11;" vertex="1">
