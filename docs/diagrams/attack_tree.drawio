        <mxCell id="def_b4" value="&lt;b&gt;[DEFENSES FOR B4]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Preventive:&lt;/b&gt; Export query strictly scoped to current_user.id&lt;br&gt;&lt;b&gt;Preventive:&lt;/b&gt; Formula injection sanitized (prepend ')&lt;br&gt;&lt;b&gt;Detective:&lt;/b&gt; AuditLogger logs REPORT_EXPORTED with record count" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontColor=#1b5e20;" vertex="1">
